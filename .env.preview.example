# Private Devin preview only. Copy to .env.preview and set the exact origin
# returned by browser_preview. Never use a wildcard or infer it from headers.
BR_ENV=preview
BR_PUBLIC_URL=
BR_AUTH_MODE=demo
BR_DATABASE_URL=sqlite:///./.local/preview/server.db
BR_DATA_DIR=.local/preview
BR_STATIC_DIR=web/dist
BR_AUTO_MIGRATE=false
BLASTRADIUS_ALEMBIC_CONFIG=alembic.ini
BLASTRADIUS_PORT=8000
# Demo sign-in creates disposable identities, not production accounts.
# Use make start ENV_FILE=.env.preview; leave .env for localhost development.
