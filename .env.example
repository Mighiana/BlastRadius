# Local tooling only. Never reuse this password outside your own machine.
POSTGRES_DB=blastradius
POSTGRES_USER=blastradius
POSTGRES_PASSWORD=local-development-only
BLASTRADIUS_PORT=8000

# Release tooling setting, NOT a server setting. Set this to the real Alembic
# config supplied by the server unit before `make migrate`; no path is assumed.
BLASTRADIUS_ALEMBIC_CONFIG=

# INTEGRATION REQUIRED: add the server's documented database/auth/static settings.
# For Compose, the database host is db:5432, NOT localhost.
# For `make dev`, choose the server's documented local SQLite configuration.
# Do not invent a database URL variable or enable development auth in production.
# See docs/release-integration.md and docs/deployment.md.
# Billing credentials remain absent unless explicitly testing sandbox billing.
