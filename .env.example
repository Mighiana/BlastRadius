# Local development only. Never reuse these settings on a public host.
POSTGRES_DB=blastradius
POSTGRES_USER=blastradius
POSTGRES_PASSWORD=local-development-only
BLASTRADIUS_PORT=8000

BLASTRADIUS_ALEMBIC_CONFIG=alembic.ini
BR_ENV=development
BR_AUTH_MODE=demo
BR_PUBLIC_URL=http://localhost:8000
BR_DATABASE_URL=sqlite:///./.local/server.db
BR_DATA_DIR=.local
BR_STATIC_DIR=web/dist
BR_AUTO_MIGRATE=false
# Without a stable secret, pending OIDC handshakes expire on restart.
# DB-backed application sessions persist until expiry or explicit revocation.
# Production requires BR_SESSION_SECRET (at least 32 characters), PostgreSQL,
# HTTPS and OIDC.
# See docs/auth.md. Payments are unavailable; no environment flag enables them.
# Operator CLI only: BR_ADMIN_ENABLED=true (never needed by the web service).
